\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces All 24 path sets: searched, manual and random (the control). A path is written from the product outwards and stands for itself and its reverse. For example, \code  {PUP} links two products reviewed by the same user. The set marked * is HAN's validation pick (Section\nonbreakingspace \ref {sec:res-random}).}}{6}{table.caption.29}\protected@file@percent }
\newlabel{tab:sets}{{2}{6}{All 24 path sets: searched, manual and random (the control). A path is written from the product outwards and stands for itself and its reverse. For example, \code {PUP} links two products reviewed by the same user. The set marked * is HAN's validation pick (Section~\ref {sec:res-random})}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Searched against manual sets: test results, mean $\pm $ standard deviation over 3 training seeds. $\Delta $: the searched set minus the manual set, with Welch's two-sided $p$. Sampled: each test edge ranked against \val  {split-negatives} negatives, with Hit@10 the metric fixed in advance. Full: against every product the user has no edge to, with Recall@20 averaged over users.}}{6}{table.caption.34}\protected@file@percent }
\newlabel{tab:main}{{3}{6}{Searched against manual sets: test results, mean $\pm $ standard deviation over 3 training seeds. $\Delta $: the searched set minus the manual set, with Welch's two-sided $p$. Sampled: each test edge ranked against \val {split-negatives} negatives, with Hit@10 the metric fixed in advance. Full: against every product the user has no edge to, with Recall@20 averaged over users}{table.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces HAN's test Hit@10 for all 24 path sets, one seed each (the main sets' standard deviation over three seeds is at most \val  {han-m6-hit-sd}). At this seed the searched sets come last among the sets drawn from the same \val  {search-cands} candidates at both sizes, though by margins within seed noise. M5 and M6 sit near the middle of the random draws. For scale: popularity \val  {pop-hit}, GAT \val  {gat-hit-mean}.}}{7}{figure.caption.35}\protected@file@percent }
\newlabel{fig:sets}{{2}{7}{HAN's test Hit@10 for all 24 path sets, one seed each (the main sets' standard deviation over three seeds is at most \val {han-m6-hit-sd}). At this seed the searched sets come last among the sets drawn from the same \val {search-cands} candidates at both sizes, though by margins within seed noise. M5 and M6 sit near the middle of the random draws. For scale: popularity \val {pop-hit}, GAT \val {gat-hit-mean}}{figure.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces What each way of choosing HAN's meta-paths costs and what it gives: test Hit@10, sampled and full ranking. By hand and by search: mean over 3 seeds. At random: mean of 5 draws, one seed each. The relative gap is to the manual set of the same size. Training HAN on the chosen set costs the same for all three, a median \val  {han-run-min} GPU minutes per run.}}{7}{table.caption.36}\protected@file@percent }
\newlabel{tab:cost}{{4}{7}{What each way of choosing HAN's meta-paths costs and what it gives: test Hit@10, sampled and full ranking. By hand and by search: mean over 3 seeds. At random: mean of 5 draws, one seed each. The relative gap is to the manual set of the same size. Training HAN on the chosen set costs the same for all three, a median \val {han-run-min} GPU minutes per run}{table.caption.36}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}What HAN does with the paths}{7}{subsection.7.4}\protected@file@percent }
